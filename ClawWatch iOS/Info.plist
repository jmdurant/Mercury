<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ClawWatch finds and connects to your OpenClaw gateway on the local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_openclaw-gw._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>ClawWatch uses the microphone for voice messages.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ClawWatch can share your location in chats.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>ClawWatch can push arrival/departure context to your AI agent.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>ClawWatch can share health status as quick replies.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>ClawWatch can share your calendar status as a quick reply.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>ClawWatch can share your next reminder as a quick reply.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>voip</string>
		<string>audio</string>
		<string>location</string>
		<string>push-to-talk</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>mercury.sync</string>
	</array>
</dict>
</plist>
