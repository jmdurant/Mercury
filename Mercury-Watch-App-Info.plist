<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMotionUsageDescription</key>
	<string>AgentOnDemand uses motion activity to choose your driving or workout auto-reply context.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AgentOnDemand needs your location to share it in chats.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>AgentOnDemand can share your workout, steps, and heart rate as quick status replies.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>AgentOnDemand reads health data for status replies. It does not request permission to add or change your health records.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>AgentOnDemand can share your calendar status as a quick reply.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>AgentOnDemand can share your next reminder as a quick reply.</string>
	<!-- Extended runtime session type for walkie-talkie conversations.
	     Per WKExtendedRuntimeSession.h the session type comes from
	     WKBackgroundModes; "self-care" is a foreground session type that
	     keeps the app running while frontmost, so a wrist-lowered send
	     completes instead of waiting for the next wrist raise. -->
	<key>WKBackgroundModes</key>
	<array>
		<string>self-care</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>AgentOnDemand finds and connects to your OpenClaw gateway on the local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_openclaw-gw._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.doctordurant.clawwatch.ios</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>
</dict>
</plist>
