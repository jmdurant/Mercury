<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Mercury needs your location to share it in chats.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Mercury can share your workout, steps, and heart rate as quick status replies.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Mercury can share your calendar status as a quick reply.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Mercury can share your next reminder as a quick reply.</string>
	<!-- Extended runtime session type for walkie-talkie conversations.
	     Per WKExtendedRuntimeSession.h the session type comes from
	     WKBackgroundModes; "self-care" is a foreground session type that
	     keeps the app running while frontmost, so a wrist-lowered send
	     completes instead of waiting for the next wrist raise. -->
	<key>WKBackgroundModes</key>
	<array>
		<string>self-care</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.doctordurant.clawwatch.ios</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>
</dict>
</plist>
